{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"dameeland-api",
  "main":"index.ts",
  "compatibility_date":"2026-04-07",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "vars":{"ALLOWED_ORIGIN":"https://dameeland.pages.dev"},
  "d1_databases":[{"binding":"DB","database_name":"dameeland","database_id":"767a9c3e-a2a0-4d72-8c0c-93d5b270e510","migrations_dir":"migrations"}],
  "kv_namespaces":[{"binding":"STORIES","id":"6238470be2fb491886d0b59cff4874f5"}],
  "r2_buckets":[{"binding":"MEDIA","bucket_name":"dameeland-media"}],
  "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"ChatRoom"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ChatRoom"]}]
}
