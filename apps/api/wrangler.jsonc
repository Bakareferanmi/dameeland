{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"dameeland-api",
  "main":"index.ts",
  "compatibility_date":"2026-04-07",
  "workers_dev":false,
  "vars":{"ALLOWED_ORIGIN":"http://localhost:5173"},
  "d1_databases":[{"binding":"DB","database_name":"dameeland","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"MEDIA","bucket_name":"dameeland-media"}],
  "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"ChatRoom"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ChatRoom"]}]
}
