{
  "expo": {
    "name": "dameen",
    "slug": "dameeland",
    "scheme": "dameen",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../../packages/core/assets/dameeland-logo.png",
    "splash": {
      "image": "../../packages/core/assets/dameeland-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F25D6"
    },
    "ios": {
      "bundleIdentifier": "com.dameeland.app"
    },
    "android": {
      "package": "com.dameeland.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dameen.app",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "dameen.app",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "@config-plugins/react-native-webrtc",
      "expo-notifications"
    ]
  }
}
